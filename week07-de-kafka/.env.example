# Hafta 7 — varsayılan ayarlar (gizli bilgi içermez, eğitim ortamıdır)
# Kullanım:  cp .env.example .env

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8095
CONNECT_URL=http://localhost:8096

# --- Topic isimleri ---
TOPIC_ORDERS=orders
TOPIC_ORDERS_DLQ=orders.dlq
TOPIC_STOCK=stock-events

# --- PostgreSQL (CDC kaynağı) ---
PGHOST=localhost
PGPORT=5437
PGUSER=kafka_user
PGPASSWORD=kafka_pass
PGDATABASE=shopdb

# --- Producer davranışı ---
EVENTS_PER_SECOND=5
